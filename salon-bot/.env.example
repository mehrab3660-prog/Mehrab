# توکن ربات که از @BotFather گرفتی
BOT_TOKEN=123456:ABC-DEF
# شناسه عددی تلگرام مدیر(های) کل، با کاما جدا شود (شناسه خودت را با دستور /id از ربات بگیر)
SUPER_ADMIN_IDS=11111111,22222222
# مسیر فایل دیتابیس
DB_PATH=salon.db
# روزهای اشتراک رایگان برای آرایشگاه تازه‌ثبت‌شده
TRIAL_DAYS=14
# پراکسی برای دور زدن فیلترینگ (اختیاری) مثلاً socks5://127.0.0.1:1080 یا http://127.0.0.1:8080
PROXY_URL=
