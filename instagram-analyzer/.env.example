# Meta App credentials (developers.facebook.com -> your app -> Settings > Basic)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must exactly match a "Valid OAuth Redirect URI" configured on the Meta app
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Random long string used to sign the OAuth state cookie
SESSION_SECRET=change-me-to-a-random-string

# Anthropic API key for the AI analysis layer (console.anthropic.com)
ANTHROPIC_API_KEY=

# SQLite by default; point elsewhere (e.g. postgresql://...) for production
DATABASE_URL=sqlite:///./instagram_analyzer.db
