DATABASE_URL="postgresql://sultan_noor:sultan_noor@localhost:5432/sultan_noor"
REDIS_URL="redis://localhost:6379"

MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="sultan_noor_master_key"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

WEB_ORIGIN="http://localhost:3000"
PORT=4000

# SMS gateway (OTP). Leave unset in dev — codes are logged to the console instead.
SMS_API_KEY=

# Zarinpal payment gateway. Leave unset to run payments in sandbox/auto-approve mode.
ZARINPAL_MERCHANT_ID=

# AI shopping advisor (optional — falls back to rule-based suggestions if unset).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Voice search transcription (optional).
OPENAI_API_KEY=

INVOICE_STORAGE_DIR=./storage/invoices
