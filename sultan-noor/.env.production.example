# Copy this file to `.env` on the server and fill in real values:
#   cp .env.production.example .env
#
# `.env` is read by docker-compose.prod.yml (both for ${VAR} substitution in
# the compose file and as the api container's env_file). It is gitignored —
# never commit it.

# --- Domain ---------------------------------------------------------------
# Public domain this stack is served on. Must already point (DNS A record)
# at this server's IP before deploy.sh requests a Let's Encrypt certificate.
DOMAIN=74211.xyz

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=sultan_noor
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=sultan_noor

# --- API (apps/api) ---------------------------------------------------------
# Random long strings — e.g. generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Must match the public site origin so the API's CORS check accepts the browser.
WEB_ORIGIN=https://74211.xyz

# All of these can be left empty and configured later from the admin
# dashboard at https://74211.xyz/admin/settings (Super Admin only) — see
# README.md "نقشه راه". They are only needed here if you'd rather set them
# once via the server instead of the dashboard.
SMS_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
ZARINPAL_MERCHANT_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=

# --- Web (apps/web) ---------------------------------------------------------
# Baked into the client bundle at build time — must be the public API URL.
NEXT_PUBLIC_API_URL=https://74211.xyz/api
NEXT_PUBLIC_SITE_URL=https://74211.xyz
