[Unit]
Description=Telegram video downloader bot
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_YOUR_USERNAME
WorkingDirectory=REPLACE_WITH_ABSOLUTE_PATH/telegram-instagram-bot
ExecStart=REPLACE_WITH_ABSOLUTE_PATH/telegram-instagram-bot/.venv/bin/python3 bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
